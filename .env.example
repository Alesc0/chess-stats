# Server Configuration
PORT=3000
DEFAULT_THEME=dark

# OpenTelemetry Configuration
# Enable OpenTelemetry instrumentation (set to "true" to enable)
OTEL_ENABLED=false

# OTLP Endpoint (e.g., Jaeger, Tempo, or any OTLP-compatible backend)
# When set, OTEL_ENABLED will be automatically enabled
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name for telemetry (optional, defaults to "chess-stats")
OTEL_SERVICE_NAME=chess-stats

# Environment name (optional, defaults to "development")
OTEL_ENVIRONMENT=development
# NODE_ENV=production
